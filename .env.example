# ═══════════════════════════════════════════
# Hard Locals Content Ops - Environment
# Copy to .env and fill real values
# ═══════════════════════════════════════════

# Server
PORT=4000

# Auth
JWT_SECRET=generate-random-string-64-chars-here
ADMIN_USER=admin
ADMIN_PASS=change-this-password

# Anthropic (required for content generation)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram (required for TG posting)
TG_BOT_TOKEN=xxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_CHANNEL_ID=@your_channel
TG_LOCAL_API=http://host.docker.internal:8082

# VK (optional, for VK posting)
# VK_ACCESS_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VK_GROUP_ID=123456789

# Image Search (optional, for /api/image-search)
UNSPLASH_KEY=
PEXELS_KEY=
